{
  "logging": {
    "loggers": {
      "global": {
        "level": "Debug",
        "format": "%Y-%m-%dT%T %z %^%s:%#%$ %L %v",
        "sinks": [
          {
            "file": {
              "path": "../../../../logs/app.log"
            }
          }
        ]
      },
      "mupdf": {
        "level": "Debug",
        "format": "%Y-%m-%dT%T %z %^%s:%#%$ %L %v",
        "sinks": [
          {
            "file": {
              "path": "../../../../logs/mupdf.log"
            }
          }
        ]
      },
      "bg": {
        "level": "Debug",
        "format": "%Y-%m-%dT%T %z %^%s:%#%$ %L %v",
        "sinks": [
          {
            "file": {
              "path": "../../../../logs/bg.log"
            }
          }
        ]
      },
      "trace": {
        "level": "Trace",
        "format": "%Y-%m-%dT%T %z %v",
        "sinks": [
          {
            "file": {
              "path": "../../../../logs/trace.log"
            }
          }
        ]
      },
      "bg-trace": {
        "level": "Trace",
        "format": "%Y-%m-%dT%T %z %v",
        "sinks": [
          {
            "file": {
              "path": "../../../../logs/bg-trace.log"
            }
          }
        ]
      }
    }
  },
  "modules": {
    "entrypoint": {
      "cls": "pdft::app::Entrypoint"
    },
    "fswatcher": {
      "cls": "pdft::notify::FswNotify"
    },
    "listener": {
      "cls": "pdft::app::AppEventListener"
    },
    "renderer": {
      "cls": "pdft::tui::AppRenderer"
    },
    "app": {
      "cls": "pdft::app::Application"
    },
    "writer": {
      "cls": "pdft::io::PosixConsoleWriter"
    },
    "reader": {
      "cls": "pdft::io::PosixConsoleReader"
    },
    "term_ctrl": {
      "cls": "pdft::io::PosixTermControl"
    },
    "terminal": {
      "cls": "pdft::tui::AnsiTerminal"
    },
    "persister": {
      "cls": "pdft::app::AppPersister"
    },
    "media_loader": {
      "cls": "pdft::media::MupdfLoader"
    },
    "state_loader": {
      "cls": "pdft::app::AppStateLoader",
      "config": {
        "mode": "AddOnly",
        "state_path": "../../../../assets/state.json"
      }
    },
    "loader": {
      "cls": "pdft::app::AppLoader"
    },
    "docs": {
      "cls": "pdft::app::DocumentStorage"
    },
    "img_renderer": {
      "cls": "pdft::app::ImageRenderer"
    },
    "palettes": {
      "cls": "pdft::app::PaletteStorage"
    },
    "apc_factory": {
      "cls": "pdft::tui::APCExecutorFactory"
    },
    "apc": {
      "factory": "apc_factory"
    },
    "display_factory": {
      "cls": "pdft::tui::KittyDisplayFactory"
    },
    "display": {
      "factory": "display_factory"
    },
    "doc_view": {
      "cls": "pdft::app::AppDocumentView"
    },
    "view": {
      "cls": "pdft::app::AppView"
    },
    "page_renderer": {
      "cls": "pdft::app::AppPageRenderer",
      "config": {
        "render_pool_size": 4,
        "num_preload_backward": 2,
        "num_preload_forward": 4
      }
    },
    "controller": {
      "cls": "pdft::app::AppController",
      "config": {
        "rows_per_scroll": 30,
        "key_mappings": [
          {
            "command": "Quit",
            "keys": "q"
          },
          {
            "command": "Reload",
            "keys": "r"
          },
          {
            "command": "CloseDocument",
            "keys": "x"
          },
          {
            "command": "ScrollNext",
            "keys": "j"
          },
          {
            "command": "ScrollPrev",
            "keys": "k"
          },
          {
            "command": "NumNextPage",
            "keys": "j"
          },
          {
            "command": "NumPrevPage",
            "keys": "k"
          },
          {
            "command": "GoToFirstPage",
            "keys": "gg"
          },
          {
            "command": "GoToLastPage",
            "keys": "G"
          },
          {
            "command": "NumGoToPage",
            "keys": "G"
          },
          {
            "command": "NextDocument",
            "keys": "l"
          },
          {
            "command": "PrevDocument",
            "keys": "h"
          },
          {
            "command": "NumNextDocument",
            "keys": "l"
          },
          {
            "command": "NumPrevDocument",
            "keys": "h"
          },
          {
            "command": "NextLayout",
            "keys": "s"
          },
          {
            "command": "PrevLayout",
            "keys": "S"
          },
          {
            "command": "InvertColors",
            "keys": "i"
          },
          {
            "command": "IncreaseScalingFactor",
            "keys": "z="
          },
          {
            "command": "DecreaseScalingFactor",
            "keys": "z-"
          },
          {
            "command": "ToggleSidebar",
            "keys": "t"
          },
          {
            "command": "ToggleBold",
            "keys": "b"
          },
          {
            "command": "TogglePalette",
            "keys": "p"
          }
        ]
      }
    }
  }
}
