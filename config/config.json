{
  "logging": {
    "loggers": {
      "global": {
        "level": "Debug",
        "format": "%Y-%m-%dT%T %z %^%s:%#%$ %L %v",
        "sinks": [
          {
            "file": {
              "path": "../../../logs/app.log"
            }
          }
        ]
      },
      "mupdf": {
        "level": "Debug",
        "format": "%Y-%m-%dT%T %z %^%s:%#%$ %L %v",
        "sinks": [
          {
            "file": {
              "path": "../../../logs/mupdf.log"
            }
          }
        ]
      },
      "bg": {
        "level": "Debug",
        "format": "%Y-%m-%dT%T %z %^%s:%#%$ %L %v",
        "sinks": [
          {
            "file": {
              "path": "../../../logs/bg.log"
            }
          }
        ]
      },
      "trace": {
        "level": "Trace",
        "format": "%Y-%m-%dT%T %z %v",
        "sinks": [
          {
            "file": {
              "path": "../../../logs/trace.log"
            }
          }
        ]
      },
      "bg-trace": {
        "level": "Trace",
        "format": "%Y-%m-%dT%T %z %v",
        "sinks": [
          {
            "file": {
              "path": "../../../logs/bg-trace.log"
            }
          }
        ]
      }
    }
  },
  "modules": {
    "entrypoint": {
      "cls": "pdft::app::Entrypoint",
      "deps": [
        "_io",
        "app"
      ]
    },
    "pdft::notify::Notify": {
      "cls": "pdft::notify::FswNotify"
    },
    "fswatcher": {
      "alias": "pdft::notify::Notify"
    },
    "console_reader": {
      "cls": "pdft::io::PosixConsoleReader"
    },
    "key_emitter": {
      "cls": "pdft::rt::KeyEventEmitter",
      "deps": [
        "_io",
        "console_reader"
      ]
    },
    "sig_emitter": {
      "cls": "pdft::rt::SignalEventEmitter",
      "config": {
        "signals": [
          2, 28
        ]
      }
    },
    "ui": {
      "cls": "pdft::app::AppUI"
    },
    "documents": {
      "cls": "pdft::app::DocumentStorage"
    },
    "doc_loader": {
      "cls": "pdft::media::MupdfLoader"
    },
    "persister": {
      "cls": "pdft::app::AppPersister",
      "deps": [
        "ui",
        "documents",
        "doc_loader"
      ]
    },
    "state_loader": {
      "cls": "pdft::app::AppStateLoader",
      "config": {
        "mode": "AddOnly",
        "state_path": "~/.local/state/pdft/state.json"
      },
      "deps": [
        "_config",
        "_cli",
        "ui",
        "documents",
        "persister",
        "doc_loader"
      ]
    },
    "palettes": {
      "cls": "pdft::app::PaletteStorage"
    },
    "loader": {
      "cls": "pdft::app::AppLoader",
      "deps": [
        "_cli",
        "ui",
        "documents",
        "state_loader",
        "fswatcher",
        "palettes"
      ]
    },
    "image_renderer": {
      "cls": "pdft::app::AppImageRenderer",
      "deps": [
        "palettes"
      ]
    },
    "page_processor": {
      "cls": "pdft::app::AppPageProcessor",
      "config": {
        "render_pool_size": 6
      },
      "deps": [
        "_config",
        "image_renderer"
      ]
    },
    "apc_executor_factory": {
      "cls": "pdft::tui::APCExecutorFactory"
    },
    "apc_executor": {
      "factory": "apc_executor_factory"
    },
    "terminal": {
      "cls": "pdft::tui::AnsiTerminal"
    },
    "image_display_factory": {
      "cls": "pdft::tui::KittyDisplayFactory",
      "config": {
        "force_unicode": false,
        "base": {
          "max_loaded_images": 128
        }
      },
      "deps": [
        "_config",
        "_cli",
        "apc_executor",
        "terminal"
      ]
    },
    "image_display": {
      "factory": "image_display_factory"
    },
    "page_renderer": {
      "cls": "pdft::app::AppPageRenderer",
      "config": {
        "image_cache_size": 128,
        "num_preload_backward": 2,
        "num_preload_forward": 6
      },
      "deps": [
        "_config",
        "documents",
        "page_processor",
        "image_display"
      ]
    },
    "document_view": {
      "cls": "pdft::app::AppDocumentView",
      "deps": [
        "page_renderer"
      ]
    },
    "view": {
      "cls": "pdft::app::AppView",
      "deps": [
        "ui",
        "documents",
        "document_view"
      ]
    },
    "console_writer": {
      "cls": "pdft::io::PosixConsoleWriter"
    },
    "term_control": {
      "cls": "pdft::io::PosixTermControl"
    },
    "renderer": {
      "cls": "pdft::tui::AppRenderer",
      "deps": [
        "terminal",
        "console_writer",
        "term_control",
        "image_display"
      ]
    },
    "app": {
      "cls": "pdft::app::Application",
      "config": {
        "event_timeout_ms": 100,
        "event_max_buffer_size": 100
      },
      "deps": [
        "_config",
        "_io",
        "loader",
        "fswatcher",
        "key_emitter",
        "sig_emitter",
        "controller",
        "view",
        "renderer"
      ]
    },
    "mupdf_context_owner": {
      "cls": "pdft::media::MupdfContextOwner",
      "logger": "mupdf",
      "config": {
        "text_aa_level": 8,
        "graphics_aa_level": 8,
        "register_as_global": true,
        "enable_icc": true,
        "setup_logging": true
      }
    },
    "controller": {
      "cls": "pdft::app::AppController",
      "deps": [
        "_config",
        "doc_loader",
        "ui",
        "documents"
      ],
      "config": {
        "rows_per_scroll": 30,
        "key_mappings": [
          {
            "command": "Quit",
            "keys": "q"
          },
          {
            "command": "Reload",
            "keys": "r"
          },
          {
            "command": "CloseDocument",
            "keys": "x"
          },
          {
            "command": "ScrollNext",
            "keys": "j"
          },
          {
            "command": "ScrollPrev",
            "keys": "k"
          },
          {
            "command": "NumNextPage",
            "keys": "j"
          },
          {
            "command": "NumPrevPage",
            "keys": "k"
          },
          {
            "command": "GoToFirstPage",
            "keys": "gg"
          },
          {
            "command": "GoToLastPage",
            "keys": "G"
          },
          {
            "command": "NumGoToPage",
            "keys": "G"
          },
          {
            "command": "NextDocument",
            "keys": "l"
          },
          {
            "command": "PrevDocument",
            "keys": "h"
          },
          {
            "command": "NumNextDocument",
            "keys": "l"
          },
          {
            "command": "NumPrevDocument",
            "keys": "h"
          },
          {
            "command": "NextLayout",
            "keys": "s"
          },
          {
            "command": "PrevLayout",
            "keys": "S"
          },
          {
            "command": "InvertColors",
            "keys": "i"
          },
          {
            "command": "IncreaseScalingFactor",
            "keys": "z="
          },
          {
            "command": "DecreaseScalingFactor",
            "keys": "z-"
          },
          {
            "command": "ToggleSidebar",
            "keys": "t"
          },
          {
            "command": "ToggleBold",
            "keys": "b"
          },
          {
            "command": "TogglePalette",
            "keys": "p"
          }
        ]
      }
    }
  }
}
